{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "description": "Django 6.1 is blocked by T434679",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "/^django$/i"
      ],
      "allowedVersions": "<6.1"
    }
  ]
}
