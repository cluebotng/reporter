{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor"
  ],
  "automerge": true,
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "description": "Django 6.1 is blocked by T434679",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "/^django$/i"
      ],
      "allowedVersions": "<6.1"
    },
    {
      "description": "Batch dev/test dependencies into a single weekly PR",
      "matchManagers": ["poetry", "pep621"],
      "matchDepTypes": ["test", "dev"],
      "groupName": "dev dependencies",
      "schedule": ["* * * * 1"]
    }
  ]
}
